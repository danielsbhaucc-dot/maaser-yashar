# העתק ל־.env לפיתוח מקומי (לא לקומיט עם מפתחות אמיתיים)
# ב־Netlify: Site settings → Environment variables
# חשוב: משתני שרת לא צריכים קידומת EXPO_PUBLIC_ (אחרת ייחשפו ללקוח)

# חובה בשרת (Netlify Functions) — לא לחשוף ללקוח
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# אופציונלי: מודל OpenRouter לצ'אט (N-18 — מודל מהיר יותר אם זמין)
# OPENROUTER_MODEL=meta-llama/llama-4-scout
# לדוגמה מודל מהיר: meta-llama/llama-3.3-70b-instruct (לפי זמינות ב־OpenRouter)

# רגרסיה לנועם (N-19): npm run test:noam
# OPENROUTER_API_KEY מספיק לקריאה מקומית ל־handler
# או: CHAT_API_URL=https://…/api/chat

# אופציונלי: מקורות מורשים ל־CORS (מופרדים בפסיקים). ברירת מחדל כוללת את האתר וה־localhost
# AI_ALLOWED_ORIGINS=https://maaser-yashar.netlify.app,http://localhost:8081

# אופציונלי בצד הלקוח — ברירת מחדל: /api/chat
# לפיתוח מקומי עם `netlify dev`:
# EXPO_PUBLIC_CHAT_API_URL=http://localhost:8888/api/chat
#
# לאפליקציית מובייל מול אתר שפורסם:
# EXPO_PUBLIC_CHAT_API_URL=https://maaser-yashar.netlify.app/api/chat
#
# ההיכרות (onboarding) מקומית לגמרי — אין קריאת רשת / אין EXPO_PUBLIC_ONBOARD_API_URL

# --- תזכורות אבטחה (ידני בדשבורד, לא בקוד) ---
# OpenRouter: הגדירו Spend / Credit limit ומחקו מפתחות ישנים.
# Netlify: ודאו ש־OPENROUTER_API_KEY מוגדר כ־Secret (לא ב־build).
