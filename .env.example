# העתק ל־.env לפיתוח מקומי (לא לקומיט עם מפתחות אמיתיים)
# ב־Netlify: Site settings → Environment variables

# חובה בשרת (Netlify Functions) — לא לחשוף ללקוח
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# אופציונלי בצד הלקוח — ברירת מחדל: /.netlify/functions/chat
# לפיתוח מקומי עם `netlify dev`:
# EXPO_PUBLIC_CHAT_API_URL=http://localhost:8888/.netlify/functions/chat
# EXPO_PUBLIC_ONBOARD_API_URL=http://localhost:8888/.netlify/functions/onboard
#
# לאפליקציית מובייל מול אתר שפורסם:
# EXPO_PUBLIC_CHAT_API_URL=https://maaser-yashar.netlify.app/.netlify/functions/chat
# EXPO_PUBLIC_ONBOARD_API_URL=https://maaser-yashar.netlify.app/.netlify/functions/onboard
